# Copy this file to .env.local and fill in your project's credentials.
# On Vercel, add the same keys under Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Supabase - stores every form submission in the `leads` table.
#
# This is the SHARED project that also backs Dingli Dealer Connect, so the
# `leads` table lives alongside that app's tables. Apply
# supabase/migrations/0004_leads.sql before going live (numbered 0004 because
# the dealer-connect repo already owns 0001-0003 on this database).
#
# The SERVICE ROLE key is used only by the route handler at app/api/leads,
# which runs server-side. It bypasses Row Level Security, so it must NEVER be
# prefixed with NEXT_PUBLIC_ - that would inline it into the browser bundle and
# hand every visitor full read/write access to your database.
# Find both values under Project Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Resend (optional) - also emails each lead so sales sees it without logging
# into Supabase. Leave blank to store leads in Supabase only.
# The sending domain must be verified in Resend first.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_NOTIFY_TO=info@dinglisaarc.com
LEAD_NOTIFY_FROM=website@dinglisaarc.com

# ---------------------------------------------------------------------------
# Dealer Connect - the partner app already deployed on Vercel.
#
# No NEXT_PUBLIC_ prefix: only server components read this, so it is rendered
# straight into an href and never shipped to client-side JavaScript. Leave it
# blank and the portal link is hidden rather than pointing nowhere.
# ---------------------------------------------------------------------------
DEALER_CONNECT_URL=https://your-dealer-connect-app.vercel.app

# ---------------------------------------------------------------------------
# Chat assistant - the "Ask us anything" widget on every page.
#
# The widget only appears when ANTHROPIC_API_KEY is set (create one at
# platform.claude.com). Chat leads are stored in Supabase as kind = 'chat'
# (apply supabase/migrations/0005_chat_leads.sql first) and emailed through
# Resend to CHAT_LEAD_NOTIFY_TO, falling back to LEAD_NOTIFY_TO.
# CHAT_MODEL is optional and defaults to claude-opus-5-5.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CHAT_LEAD_NOTIFY_TO=
CHAT_MODEL=

# With none of the above set, the forms still work: submissions are validated
# and logged to the server console. Useful locally, not suitable for production.

# ---------------------------------------------------------------------------
# CMS (Payload) - the admin at /admin for blog posts, used machines, team,
# the expo banner and images.
#
# DATABASE_URL: the Supabase Postgres connection string. Use the "Session
# pooler" string from Supabase -> Connect (port 5432). Payload keeps its tables
# in its own "payload" schema, separate from Dealer Connect and the leads table.
#
# Each deploy runs `payload migrate` before building. The first deploy creates
# the tables, imports the current content and creates the first admin from
# INITIAL_ADMIN_EMAIL / INITIAL_ADMIN_PASSWORD (the deploy stops if those are
# missing while there are no users). Remove them after the first deploy.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
PAYLOAD_SECRET=a-long-random-string
NEXT_PUBLIC_SERVER_URL=https://www.dinglisaarc.com
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Images: Supabase Storage through its S3-compatible API. Create a PUBLIC
# bucket (e.g. "media"), then Storage -> S3 Connection -> New access key.
S3_BUCKET=media
S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/media
